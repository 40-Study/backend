# H-04 (audit 260909 vòng 2): mẫu biến môi trường — CHỈ tên biến + placeholder, KHÔNG chứa
# giá trị thật. Copy file này thành .env (dev) hoặc .env.prod (prod) rồi điền giá trị thật.
# JWT_SECRET đặc biệt BẮT BUỘC phải khác rỗng và khác giá trị mặc định cũ — LoadConfig() sẽ
# từ chối khởi động nếu thiếu (xem internal/config/config.go).

ENVIRONMENT=dev
PORT=5000
HOST=localhost

# ===== Database (Postgres) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=changeme
DB_PASSWORD=changeme
DB_NAME=study40

# Dùng cho docker-compose khởi tạo Postgres container
POSTGRES_DB=study40
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== MinIO (Object Storage) =====
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_USE_SSL=false
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_VIDEOS=videos
MINIO_BUCKET_NAME=videos

# Dùng cho docker-compose khởi tạo MinIO container
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# ===== SMTP (gửi email/OTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=changeme@example.com
SMTP_PASSWORD=changeme
FROM_EMAIL=changeme@example.com
FROM_NAME=40Study

# ===== JWT (BẮT BUỘC — xem ghi chú H-04 ở đầu file) =====
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# ===== Ngân hàng / thanh toán chuyển khoản (MBBank) =====
MB_USERNAME=changeme
MB_PASSWORD=changeme
MB_ACCOUNT_NO=changeme
MB_BANK_NAME=MBBank
BANK_ACCOUNT_NAME=changeme

# ===== gRPC Transaction Service (xác minh giao dịch ngân hàng) =====
TRANSACTION_SERVICE_HOST=localhost
TRANSACTION_SERVICE_PORT=50051

# ===== RabbitMQ =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=changeme
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/

# ===== LiveKit (livestream) =====
LIVEKIT_URL=
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme
LIVEKIT_NODE_IP=
LIVEKIT_NODE_PORT=

# ===== OAuth =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=

# ===== Web / CORS =====
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ===== Khác =====
PARENT_INVITATION_DAILY_LIMIT=5
TEMP_DIR=./tmp
