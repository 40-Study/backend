# H-04 (audit 260909 vòng 2): mẫu biến môi trường — CHỈ tên biến + placeholder, KHÔNG chứa
# giá trị thật. Copy file này thành .env (dev) hoặc .env.prod (prod) rồi điền giá trị thật.
# JWT_SECRET đặc biệt BẮT BUỘC phải khác rỗng và khác giá trị mặc định cũ — LoadConfig() sẽ
# từ chối khởi động nếu thiếu (xem internal/config/config.go).

ENVIRONMENT=dev
# PORT (CHỈ cho dev local): 5001, không phải 5000 — macOS (AirPlay Receiver / ControlCenter) chiếm cổng
# 5000; web .env.example cũng trỏ về http://localhost:5001/api. PRODUCTION GIỮ PORT RIÊNG của nó (hiện
# 5000, khớp upstream trong nginx/nginx.conf): file này không đổi PORT của prod; muốn đổi cổng prod phải
# sửa .env prod và upstream nginx trong CÙNG một lần deploy. Không đặt PORT thì code dùng mặc định 5001
# (config.DefaultPort, phải trùng giá trị ở đây — internal/config/env_example_test.go kiểm).
PORT=5001
# HOST (review vòng 3, PR #69): địa chỉ Fiber Listen (Run() dùng "HOST:PORT" — xem app.go). Mặc
# định "localhost" đã đúng ý nghĩa an toàn: chỉ nhận kết nối cục bộ. PRODUCTION BẮT BUỘC giữ
# nguyên giá trị này (hoặc "127.0.0.1") — KHÔNG đổi thành "0.0.0.0"/địa chỉ public trừ khi có
# firewall/mạng nội bộ đảm bảo CHỈ nginx gọi được tới cổng này. Nếu cổng backend lộ trực tiếp ra
# ngoài, ClientIP() (xem internal/middleware/client_ip.go) không còn phân biệt được kẻ tấn công
# với nginx thật — mọi rate-limit theo IP có thể bị né bằng cách client tự xoay X-Forwarded-For.
HOST=localhost

# ===== Database (Postgres) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=changeme
DB_PASSWORD=changeme
DB_NAME=study40

# Dùng cho docker-compose khởi tạo Postgres container
POSTGRES_DB=study40
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
# docker-compose.yaml bắt buộc REDIS_PASSWORD khác rỗng (redis-server --requirepass).
REDIS_PASSWORD=changeme
REDIS_DB=0

# ===== MinIO (Object Storage) =====
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_USE_SSL=false
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_VIDEOS=videos
MINIO_BUCKET_NAME=videos
# Bucket VIDEO (MINIO_BUCKET_NAME, va MINIO_BUCKET_VIDEOS neu khac bucket anh) la PRIVATE: backend go policy
# public-read moi lan khoi dong; video/phu de chi xem qua /api/hls/* bang URL ky (HLS_SIGNING_SECRET).
# MINIO_BUCKET_NAME KHONG duoc trung MINIO_BUCKET_IMAGES (bucket anh phai public).

# Dùng cho docker-compose khởi tạo MinIO container
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# ===== SMTP (gửi email/OTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=changeme@example.com
SMTP_PASSWORD=changeme
FROM_EMAIL=changeme@example.com
FROM_NAME=40Study

# ===== JWT (BẮT BUỘC — xem ghi chú H-04 ở đầu file) =====
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# ===== Ký URL video HLS (BẮT BUỘC) =====
# /api/hls/* chỉ phục vụ URL có chữ ký HMAC ngắn hạn (2 giờ). Thiếu, còn giá trị mẫu "changeme...",
# hoặc ngắn hơn 32 ký tự thì backend KHÔNG khởi động. Sinh secret: openssl rand -hex 32
HLS_SIGNING_SECRET=changeme-generate-with-openssl-rand-hex-32

# ===== Ngân hàng / thanh toán chuyển khoản (MBBank) =====
MB_USERNAME=changeme
MB_PASSWORD=changeme
MB_ACCOUNT_NO=changeme
MB_BANK_NAME=MBBank
BANK_ACCOUNT_NAME=changeme

# ===== gRPC Transaction Service (xác minh giao dịch ngân hàng) =====
TRANSACTION_SERVICE_HOST=localhost
TRANSACTION_SERVICE_PORT=50051
# S6: secret dùng chung giữa backend Go và service giao dịch Python (gRPC :50051 và REST :8000). Sinh ngẫu nhiên
# (vd `openssl rand -hex 32`), đặt CÙNG giá trị ở cả hai phía. Bật theo thứ tự: backend Go trước, service Python sau.
# BẮT BUỘC ở service Python: thiếu biến này thì REST và gRPC từ chối khởi động. Chỉ máy dev mới được thay bằng
# ALLOW_INSECURE_TRANSACTIONS=1 (chạy không xác thực, có cảnh báo). Backend Go để trống = không gửi token, nhưng
# docker-compose.yaml (service mbbank-api) bắt buộc biến này khác rỗng.
TRANSACTION_SERVICE_TOKEN=changeme-generate-with-openssl-rand-hex-32

# ===== RabbitMQ =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=changeme
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/

# ===== LiveKit (livestream) =====
LIVEKIT_URL=
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme
# docker-compose.yaml bắt buộc khác rỗng. Dev local: 127.0.0.1; server: IP public mà client WebRTC nối tới.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_NODE_PORT=

# ===== OAuth =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub OAuth: redirect URL của OAuth App phải trùng GITHUB_REDIRECT_URL. App dev đã đăng ký với
# http://localhost:5000/oauth/github/callback thì khi chuyển PORT local sang 5001 phải sửa callback
# trên GitHub (Developer settings) thành http://localhost:5001/oauth/github/callback.
GITHUB_REDIRECT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=

# ===== Web / CORS =====
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# TRUSTED_PROXIES (review PR #69 BLOCKER, QA 260927): danh sách IP/CIDR (cách nhau bằng dấu
# phẩy) của các hop đứng NGAY TRƯỚC Fiber mà server tin để đọc header X-Forwarded-For thay vì
# TCP peer trực tiếp. Web gọi backend qua proxy server-side của Next.js
# (web/src/app/api/[...path]/route.ts) — trình duyệt luôn nối Next.js trước, Next.js mới là bên
# thật sự mở kết nối TCP tới backend, nên KHÔNG cấu hình đúng biến này sẽ khiến mọi rate limiter
# theo IP (login, refresh-token...) chia sẻ 1 bucket cho TOÀN BỘ website (mọi request đứng chung
# 1 "TCP peer" — IP của Next.js), không phải riêng cho từng người dùng.
# Mặc định khi để trống: "127.0.0.1,::1" (chỉ đúng khi Next.js chạy CÙNG máy/host với backend).
# Production dùng Next.js server ở máy/container khác PHẢI đặt đúng IP thật của nó ở đây, nếu
# không request thật sẽ bị coi là "peer không tin cậy" và quay về hành vi lỗi ở trên.
#
# Review vòng 3 (PR #69): topology thật của repo này là trình duyệt -> nginx (nginx/nginx.conf,
# đã đúng `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for`) -> Next.js -> backend.
# TRUSTED_PROXIES ở ĐÂY phải liệt kê IP/CIDR của hop NGAY TRƯỚC BACKEND (thường là Next.js/nginx
# tuỳ Next có tự gọi thẳng backend hay không — xác nhận qua docker-compose/hạ tầng thật, IP
# container docker-compose không cố định là "127.0.0.1"). Giá trị này CHỈ có ý nghĩa bảo vệ nếu
# HOST ở trên KHÔNG lộ backend ra ngoài trực tiếp — xem comment ở HOST và ở
# internal/middleware/client_ip.go#ClientIP. Lớp phòng thủ độc lập với biến này:
# internal/middleware/account_lockout.go (khoá theo email, không phụ thuộc IP/XFF).
TRUSTED_PROXIES=127.0.0.1,::1

# ===== Khác =====
PARENT_INVITATION_DAILY_LIMIT=5
TEMP_DIR=./tmp

# Số tiền rút tối thiểu của giảng viên (VND). Mặc định 100000 nếu bỏ trống; phải là số > 0.
WITHDRAWAL_MIN_AMOUNT=100000

# Số phút tối đa một instance khởi động chờ khoá migrate khi instance khác đang migrate. Mặc định 45; hợp lệ 1-1440.
# Hết giờ thì khởi động dừng với lỗi rõ ràng (không tự migrate song song).
MIGRATE_LOCK_TIMEOUT_MINUTES=45

# Open Design / Viettel AI (server only; never expose as NEXT_PUBLIC_*).
# OpenAI-compatible MaaS chat API, verified with the provider on 2026-10-18.
# BASE_URL ends at /v1; the backend appends /chat/completions. Keep the key server-only.
VIETTEL_AI_API_KEY=
VIETTEL_AI_BASE_URL=https://viettelai.vn/model-as-a-service/v1
VIETTEL_AI_MODEL=DeepSeek-V4-Flash

# Optional Judge0 endpoint; dev default http://localhost:2358, Docker http://judge_server:2358
JUDGE0_URL=

# ===== Cổng host của docker-compose.yaml (BẮT BUỘC: compose dùng ${VAR:?...}, thiếu là `docker compose up` dừng) =====
# Mặc định = cổng trong container. Cổng nào trùng dịch vụ đang chạy trên máy thì đổi ở đây, và đổi luôn biến client
# tương ứng ở trên (POSTGRES_HOST_PORT <-> DB_PORT, REDIS_HOST_PORT <-> REDIS_PORT, RABBITMQ_HOST_PORT <-> RABBITMQ_PORT,
# MINIO_API_HOST_PORT <-> MINIO_PORT/MINIO_ENDPOINT, MBBANK_GRPC_HOST_PORT <-> TRANSACTION_SERVICE_PORT,
# JUDGE0_HOST_PORT <-> JUDGE0_URL). internal/config/env_example_test.go kiểm file này có đủ mọi biến bắt buộc.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
JUDGE0_HOST_PORT=2358
MBBANK_REST_HOST_PORT=8000
MBBANK_GRPC_HOST_PORT=50051
LIVEKIT_HTTP_HOST_PORT=7880
LIVEKIT_RTC_TCP_HOST_PORT=7881
LIVEKIT_RTC_UDP_HOST_PORT=7882
# nginx (cổng 80 trong container); 8080 để không cần quyền root cho cổng 80 trên host.
STUDY_NGINX_HOST_PORT=8080
