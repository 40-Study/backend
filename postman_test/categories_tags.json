{
  "info": {
    "name": "Categories & Tags",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "category_id", "value": "" },
    { "key": "tag_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/categories"
          }
        },
        {
          "name": "Get Category By ID (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/categories/{{category_id}}"
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/categories",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Programming\",\n  \"parent_id\": null,\n  \"description\": \"Programming courses\",\n  \"icon_url\": null,\n  \"display_order\": 1\n}"
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/categories/{{category_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Advanced Programming\",\n  \"description\": \"Updated description\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/categories/{{category_id}}"
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "Get All Tags (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tags?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["tags"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "keyword", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Tag By ID (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/tags/{{tag_id}}"
          }
        },
        {
          "name": "Create Tag",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/tags",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"golang\"\n}"
            }
          }
        },
        {
          "name": "Update Tag",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/tags/{{tag_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"go-language\"\n}"
            }
          }
        },
        {
          "name": "Delete Tag",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/tags/{{tag_id}}"
          }
        }
      ]
    }
  ]
}
