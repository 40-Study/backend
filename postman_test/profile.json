{
  "info": {
    "name": "Profile",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Get My Children",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/me/children"
      }
    },
    {
      "name": "Get My Organizations",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/me/organizations"
      }
    },
    {
      "name": "Get My Org Roles",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/me/org-roles"
      }
    }
  ]
}
