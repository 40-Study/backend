{
  "info": {
    "name": "Classes (under Courses)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "course_id", "value": "" },
    { "key": "class_id", "value": "" },
    { "key": "teacher_id", "value": "" },
    { "key": "student_id", "value": "" },
    { "key": "attendance_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Classes",
      "item": [
        {
          "name": "Get Classes by Course",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses/{{course_id}}/classes"
          }
        },
        {
          "name": "Create Class for Course",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/courses/{{course_id}}/classes",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CS101\",\n  \"description\": \"Intro to Computer Science\",\n  \"max_students\": 50,\n  \"start_date\": \"2025-01-01\",\n  \"end_date\": \"2025-06-01\"\n}"
            }
          }
        },
        {
          "name": "Get Class By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}"
          }
        },
        {
          "name": "Update Class",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CS101 - Updated\",\n  \"description\": \"Updated description\",\n  \"status\": \"active\",\n  \"max_students\": 60\n}"
            }
          }
        },
        {
          "name": "Delete Class",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}"
          }
        }
      ]
    },
    {
      "name": "Teacher-Class",
      "item": [
        {
          "name": "Assign Teacher To Class",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/teachers",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacher_id\": \"<teacher_uuid>\",\n  \"role\": \"primary\"\n}"
            }
          }
        },
        {
          "name": "Remove Teacher From Class",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/teachers/{{teacher_id}}"
          }
        },
        {
          "name": "Get Teachers By Class",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/teachers"
          }
        }
      ]
    },
    {
      "name": "Student-Class",
      "item": [
        {
          "name": "Enroll Student To Class",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/students",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"<student_uuid>\"\n}"
            }
          }
        },
        {
          "name": "Remove Student From Class",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/students/{{student_id}}"
          }
        },
        {
          "name": "Get Students By Class",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/students"
          }
        }
      ]
    },
    {
      "name": "Content Schedule",
      "item": [
        {
          "name": "Get Content Schedule for Class",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/contents?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["courses", "{{course_id}}", "classes", "{{class_id}}", "contents"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Attendances",
      "item": [
        {
          "name": "Mark Attendance",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/attendances",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"<student_uuid>\",\n  \"date\": \"2025-01-15\",\n  \"status\": \"present\",\n  \"note\": \"On time\"\n}"
            }
          }
        },
        {
          "name": "Get All Attendances",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/attendances"
          }
        },
        {
          "name": "Get Attendance By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/attendances/{{attendance_id}}"
          }
        },
        {
          "name": "Update Attendance",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/attendances/{{attendance_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"absent\",\n  \"note\": \"Sick leave\"\n}"
            }
          }
        },
        {
          "name": "Delete Attendance",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/courses/{{course_id}}/classes/{{class_id}}/attendances/{{attendance_id}}"
          }
        }
      ]
    }
  ]
}
