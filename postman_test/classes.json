{
  "info": {
    "name": "Classes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "class_id", "value": "" },
    { "key": "teacher_id", "value": "" },
    { "key": "student_id", "value": "" },
    { "key": "schedule_id", "value": "" },
    { "key": "attendance_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Classes",
      "item": [
        {
          "name": "Create Class",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/classes",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CS101\",\n  \"description\": \"Intro to Computer Science\",\n  \"course_id\": null,\n  \"max_students\": 50,\n  \"start_date\": \"2025-01-01\",\n  \"end_date\": \"2025-06-01\"\n}"
            }
          }
        },
        {
          "name": "Get All Classes",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/classes"
          }
        },
        {
          "name": "Get Class By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/classes/{{class_id}}"
          }
        },
        {
          "name": "Update Class",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/classes/{{class_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CS101 - Updated\",\n  \"description\": \"Updated description\",\n  \"status\": \"active\",\n  \"max_students\": 60\n}"
            }
          }
        },
        {
          "name": "Delete Class",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/classes/{{class_id}}"
          }
        }
      ]
    },
    {
      "name": "Teacher-Class",
      "item": [
        {
          "name": "Assign Teacher To Class",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/classes/{{class_id}}/teachers",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teachers\": [\n    {\n      \"teacher_id\": \"<teacher_uuid>\",\n      \"role\": \"main\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Remove Teacher From Class",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/classes/{{class_id}}/teachers/{{teacher_id}}"
          }
        },
        {
          "name": "Get Teachers By Class",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/classes/{{class_id}}/teachers"
          }
        }
      ]
    },
    {
      "name": "Student-Class",
      "item": [
        {
          "name": "Enroll Student To Class",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/classes/{{class_id}}/students",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"<student_uuid>\"\n}"
            }
          }
        },
        {
          "name": "Remove Student From Class",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/classes/{{class_id}}/students/{{student_id}}"
          }
        },
        {
          "name": "Get Students By Class",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/classes/{{class_id}}/students"
          }
        }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "Create Class Schedule",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/classes/{{class_id}}/schedules",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day_of_week\": 1,\n  \"start_time\": \"08:00\",\n  \"end_time\": \"10:00\",\n  \"room\": \"A101\"\n}"
            }
          }
        },
        {
          "name": "Get All Class Schedules",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/classes/{{class_id}}/schedules"
          }
        },
        {
          "name": "Update Class Schedule",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/classes/{{class_id}}/schedules/{{schedule_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day_of_week\": 2,\n  \"start_time\": \"09:00\",\n  \"end_time\": \"11:00\",\n  \"room\": \"B202\"\n}"
            }
          }
        },
        {
          "name": "Delete Class Schedule",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/classes/{{class_id}}/schedules/{{schedule_id}}"
          }
        }
      ]
    },
    {
      "name": "Attendances",
      "item": [
        {
          "name": "Mark Attendance",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/classes/{{class_id}}/attendances",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"<student_uuid>\",\n  \"date\": \"2025-01-15\",\n  \"status\": \"present\",\n  \"note\": \"On time\"\n}"
            }
          }
        },
        {
          "name": "Get All Attendances",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/classes/{{class_id}}/attendances"
          }
        },
        {
          "name": "Get Attendance By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/classes/{{class_id}}/attendances/{{attendance_id}}"
          }
        },
        {
          "name": "Update Attendance",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/classes/{{class_id}}/attendances/{{attendance_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"absent\",\n  \"note\": \"Sick leave\"\n}"
            }
          }
        },
        {
          "name": "Delete Attendance",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/classes/{{class_id}}/attendances/{{attendance_id}}"
          }
        }
      ]
    }
  ]
}
