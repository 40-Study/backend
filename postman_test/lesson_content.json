{
  "info": {
    "name": "Lesson Content",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "lesson_id", "value": "" },
    { "key": "attachment_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Video",
      "item": [
        {
          "name": "Get Video (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/lessons/{{lesson_id}}/video"
          }
        },
        {
          "name": "Create Video",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/lessons/{{lesson_id}}/video",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_url\": \"https://example.com/video.mp4\",\n  \"video_hls_url\": null,\n  \"thumbnail_url\": null,\n  \"duration_seconds\": 900,\n  \"resolution\": \"1080p\",\n  \"file_size_bytes\": 104857600\n}"
            }
          }
        },
        {
          "name": "Update Video",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/lessons/{{lesson_id}}/video",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_url\": \"https://example.com/video-v2.mp4\",\n  \"duration_seconds\": 1200\n}"
            }
          }
        },
        {
          "name": "Delete Video",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/lessons/{{lesson_id}}/video"
          }
        }
      ]
    },
    {
      "name": "Article",
      "item": [
        {
          "name": "Get Article (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/lessons/{{lesson_id}}/article"
          }
        },
        {
          "name": "Create Article",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/lessons/{{lesson_id}}/article",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"# Introduction\\n\\nThis is a lesson article...\",\n  \"reading_time_minutes\": 10\n}"
            }
          }
        },
        {
          "name": "Update Article",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/lessons/{{lesson_id}}/article",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"# Updated Article\\n\\nNew content...\",\n  \"reading_time_minutes\": 15\n}"
            }
          }
        },
        {
          "name": "Delete Article",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/lessons/{{lesson_id}}/article"
          }
        }
      ]
    },
    {
      "name": "Attachments",
      "item": [
        {
          "name": "Get Attachments (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/lessons/{{lesson_id}}/attachments"
          }
        },
        {
          "name": "Create Attachment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/lessons/{{lesson_id}}/attachments",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_name\": \"slides.pdf\",\n  \"file_url\": \"https://example.com/slides.pdf\",\n  \"file_type\": \"application/pdf\",\n  \"file_size_bytes\": 2097152\n}"
            }
          }
        },
        {
          "name": "Delete Attachment",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/lessons/{{lesson_id}}/attachments/{{attachment_id}}"
          }
        }
      ]
    }
  ]
}
