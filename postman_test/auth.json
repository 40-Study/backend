{
  "info": {
    "name": "Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "session_token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Request Register (OTP)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/register/request",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\"\n}"
        }
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/register",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"confirm_password\": \"Password123!\",\n  \"user_name\": \"johndoe\",\n  \"full_name\": \"John Doe\",\n  \"role_ids\": []\n}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"device_info\": {\n    \"device_id\": \"device-001\",\n    \"device_name\": \"Chrome Browser\",\n    \"os\": \"Windows 11\",\n    \"app_version\": \"1.0.0\",\n    \"user_agent\": \"PostmanRuntime\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.data && json.data.access_token) {",
              "  pm.collectionVariables.set('token', json.data.access_token);",
              "  pm.collectionVariables.set('refresh_token', json.data.refresh_token);",
              "}",
              "if (json.data && json.data.session_token) {",
              "  pm.collectionVariables.set('session_token', json.data.session_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Select Profile",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/select-profile",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_token\": \"{{session_token}}\",\n  \"system_role_id\": \"<system_role_id>\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.data && json.data.access_token) {",
              "  pm.collectionVariables.set('token', json.data.access_token);",
              "  pm.collectionVariables.set('refresh_token', json.data.refresh_token);",
              "}",
              "if (json.data && json.data.session_token) {",
              "  pm.collectionVariables.set('session_token', json.data.session_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Select Org",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/select-org",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_token\": \"{{session_token}}\",\n  \"organization_id\": \"<organization_id>\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.data && json.data.access_token) {",
              "  pm.collectionVariables.set('token', json.data.access_token);",
              "  pm.collectionVariables.set('refresh_token', json.data.refresh_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Request Password Reset",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/reset-password/request",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\"\n}"
        }
      }
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/reset-password",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"new_password\": \"NewPassword123!\",\n  \"confirm_password\": \"NewPassword123!\"\n}"
        }
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/refresh-token",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.data && json.data.access_token) {",
              "  pm.collectionVariables.set('token', json.data.access_token);",
              "  pm.collectionVariables.set('refresh_token', json.data.refresh_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Switch Profile",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "POST",
        "url": "{{base_url}}/auth/switch-profile",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"system_role_id\": \"<system_role_id>\"\n}"
        }
      }
    },
    {
      "name": "Switch Org",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "POST",
        "url": "{{base_url}}/auth/switch-org",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organization_id\": \"<organization_id>\"\n}"
        }
      }
    },
    {
      "name": "Get Me",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{base_url}}/auth/me"
      }
    },
    {
      "name": "Update Me",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "PUT",
        "url": "{{base_url}}/auth/me",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"newusername\",\n  \"phone\": \"0123456789\",\n  \"date_of_birth\": \"2000-01-01\"\n}"
        }
      }
    },
    {
      "name": "Get All Devices",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "url": "{{base_url}}/auth/devices"
      }
    },
    {
      "name": "Logout One Device",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "POST",
        "url": "{{base_url}}/auth/logout",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"device-001\"\n}"
        }
      }
    },
    {
      "name": "Logout All",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "POST",
        "url": "{{base_url}}/auth/logout-all"
      }
    },
    {
      "name": "Change Password",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "PUT",
        "url": "{{base_url}}/auth/change-password",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"old_password\": \"Password123!\",\n  \"new_password\": \"NewPassword456!\",\n  \"confirm_password\": \"NewPassword456!\",\n  \"device_info\": {\n    \"device_id\": \"device-001\",\n    \"device_name\": \"Chrome Browser\",\n    \"os\": \"Windows 11\",\n    \"app_version\": \"1.0.0\",\n    \"user_agent\": \"PostmanRuntime\"\n  },\n  \"revoke_others\": false\n}"
        }
      }
    }
  ]
}
