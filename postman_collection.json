						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register/request",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register", "request"]
						}
					}
				},
